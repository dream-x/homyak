DATABASE_URL=postgresql+asyncpg://homyak:homyak@localhost:5432/homyak
QDRANT_URL=http://localhost:6333
NATS_URL=nats://localhost:4222
OLLAMA_URL=http://localhost:11434

# Phase 3: эмбеддинги + similarity
EMBEDDING_MODEL=bge-m3
EMBEDDING_VERSION=1
EMBEDDING_BATCH_SIZE=32
SIMILARITY_THRESHOLD=0.88
# Путь к outbox, который пишет пропатченный tscrapper (для homyak-tg-relay)
TELEGRAM_OUTBOX_PATH=/var/lib/tscrapper/outbox.jsonl

# Phase 4: LLM
LLM_MODEL=qwen2.5:14b
SUMMARY_MODEL=qwen3:32b   # модель побольше для качественных саммари (think отключён)

# Phase 6: персонализация (веса свёртки personal_score, сумма ≈ 1.0)
PERSONALIZE_LLM_WEIGHT=0.50
PERSONALIZE_TASTE_WEIGHT=0.20
PERSONALIZE_TAG_WEIGHT=0.15
PERSONALIZE_SOURCE_WEIGHT=0.10
PERSONALIZE_FRESH_WEIGHT=0.05
TASTE_RAMP=20
PUSH_THRESHOLD=0.55
FEEDBACK_LR=0.10
TASTE_NEG_LR=0.03
MAX_PUSH_PER_HOUR=8
QUIET_HOURS=0-8

# Telegram-бот (токен от @BotFather — только в .env, не в git)
# TELEGRAM_BOT_TOKEN=123456:ABC...
