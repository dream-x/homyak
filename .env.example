DATABASE_URL=postgresql+asyncpg://homyak:homyak@localhost:5432/homyak
QDRANT_URL=http://localhost:6333
NATS_URL=nats://localhost:4222
OLLAMA_URL=http://localhost:11434

# Phase 3: эмбеддинги + similarity
EMBEDDING_MODEL=bge-m3
EMBEDDING_VERSION=1
EMBEDDING_BATCH_SIZE=32
SIMILARITY_THRESHOLD=0.88
# Путь к outbox, который пишет пропатченный tscrapper (для homyak-tg-relay)
TELEGRAM_OUTBOX_PATH=/var/lib/tscrapper/outbox.jsonl

# Phase 4: LLM
LLM_MODEL=qwen2.5:14b
SUMMARY_MODEL=qwen3:32b   # модель побольше для качественных саммари (think отключён)

# Веса свёртки personal_score, taste_ramp, порог пуша, порог гейта — НЕ здесь.
# Они переехали в config/interests.yaml (секция weights), туда же, где сами интересы:
# «что мне нравится» не должно задаваться в шести местах. Settings игнорирует лишние
# env-переменные молча, поэтому PERSONALIZE_*/TASTE_RAMP/PUSH_THRESHOLD тут больше не место —
# они бы просто не работали.
FEEDBACK_LR=0.10
TASTE_NEG_LR=0.03
MAX_PUSH_PER_HOUR=8
QUIET_HOURS=0-8

# Telegram-бот (токен от @BotFather — только в .env, не в git)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Приватный бот: разрешённые Telegram user id через запятую. Пусто = НИКОГО (fail-closed).
# Свой id узнать: напиши @userinfobot. Без этого любой по @username читает твои ленты и /start'ом угоняет пуши.
# TELEGRAM_ALLOWED_IDS=123456789
# Twitter в пушах — свой пониженный порог + обходит pushonly-скоуп (больше tw-инсайдов)
# TWITTER_PUSH_THRESHOLD=0.50
# Лента-канал: бот публикует общую ленту (все вертикали) в отдельный TG-канал.
# Бот должен быть админом канала. ID канала (-100…) или @username. Пусто = выключено.
# CHANNEL_MIN_SCORE: 0.60≈350/сутки, 0.50≈815, 0.65≈183.
# FEED_CHANNEL_ID=
# CHANNEL_MIN_SCORE=0.60
PROFILE_REFINE_EVERY=10

# Phase 5: Twitter/X через RSSHub (self-hosted мост)
# auth_token cookie из твоего X-аккаунта (DevTools → Application → Cookies → auth_token).
# Можно несколько через запятую. Без него twitter-роуты RSSHub не работают.
TWITTER_AUTH_TOKEN=

# Ollama: основной хост (GPU-бокс) и запасной (локальный). Модели у них могут отличаться.
OLLAMA_URL=http://<gpu-host>:11434
OLLAMA_URL_FALLBACK=http://host.containers.internal:11434
LLM_MODEL=qwen3.6:27b
LLM_MODEL_FALLBACK=qwen3.5:9b
